# Backend — PLATFORM (Yours): AI + data plane
ENVIRONMENT=development
# Local/dev only. Production MUST use Railway Postgres (postgresql://… URL).
DATABASE_URL=sqlite:///./revisit.db
# Production escape hatch only (data still wiped on redeploy):
# ALLOW_EPHEMERAL_SQLITE=true
REDIS_URL=redis://127.0.0.1:6379/0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://revisit.argusai.online
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=720
PUBLIC_BASE_URL=http://127.0.0.1:8000
FRONTEND_BASE_URL=https://revisit.argusai.online
ARGUS_SITE_URL=https://argusai.online
ARGUS_PRODUCT_LINE=Argus OS
SEED_ON_STARTUP=true
AUTO_CREATE_TABLES=true
RATE_LIMIT_PER_MINUTE=120
CSV_MAX_BYTES=1000000
CSV_MAX_ROWS=500

# Platform owner (main admin for the seeded hotel workspace + /admin)
# Set these on the API service — never put real passwords in the frontend.
# Leave OWNER_EMAIL blank to use the built-in default (dkhadikar@gmail.com).
# Do not set a different blank/whitespace value intending to disable admin.
OWNER_EMAIL=dkhadikar@gmail.com
OWNER_NAME=Deepanshu
OWNER_PASSWORD=

# AI Gateway — PLATFORM account (pay per token; initially yours)
# Routine welcome / reminders / review asks use the zero-cost template agent.
# PILOT_READINESS.md §3 — a real pilot MUST set USE_MOCK_AI=false and a
# real OPENAI_API_KEY. If ENVIRONMENT=production and either is still
# missing, the app now refuses to start (see reject_mock_mode_in_
# production in app/core/config.py) rather than silently running guest
# traffic through the mock/passthrough path. Escape hatch for a
# deliberate non-guest-facing production deployment only:
# ALLOW_MOCK_MODE_IN_PRODUCTION=true
USE_MOCK_AI=true
ZERO_COST_AGENT_ENABLED=true
LLM_FOR_UPSELLS=false
LLM_FOR_REVIEW_REPLIES=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# --- CLIENT-OWNED credentials (hotel connects their accounts) ---

# Priority 1 — Cloudbeds (Client PMS)
CLOUDBEDS_CLIENT_ID=
CLOUDBEDS_CLIENT_SECRET=
CLOUDBEDS_API_KEY=
CLOUDBEDS_PROPERTY_ID=
CLOUDBEDS_REDIRECT_URI=http://127.0.0.1:8000/api/webhooks/cloudbeds/oauth/callback

# Priority 2 — WhatsApp Business (Client Meta WABA)
# PILOT_READINESS.md §3 — same go-live guard as above: WHATSAPP_ACCESS_
# TOKEN must be set for a real production pilot, or the app refuses to
# start (mock WhatsApp sends never reach a real phone).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=revisit-whatsapp-verify
WHATSAPP_APP_SECRET=

# Priority 3 — Email (Client; Resend preferred, Postmark alternative)
EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=

# Priority 5 — Google Business Profile (Client; official API only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_ACCOUNT_ID=
GOOGLE_LOCATION_ID=

# Priority 6 — Stripe upsells (Client Stripe account)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=eur

# Frontend
INTERNAL_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_ARGUS_SITE_URL=https://argusai.online
NEXT_PUBLIC_REVISIT_SITE_URL=https://revisit.argusai.online
# Do not set NEXT_PUBLIC_API_URL for browser absolute calls in Docker;
# the app uses same-origin /api rewrites instead.
