# Backend — PLATFORM (Yours): AI + data plane
ENVIRONMENT=development
DATABASE_URL=sqlite:///./revisit.db
REDIS_URL=redis://127.0.0.1:6379/0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=720
PUBLIC_BASE_URL=http://127.0.0.1:8000
FRONTEND_BASE_URL=http://localhost:3000
SEED_ON_STARTUP=true
AUTO_CREATE_TABLES=true
RATE_LIMIT_PER_MINUTE=120
CSV_MAX_BYTES=1000000
CSV_MAX_ROWS=500

# AI Gateway — PLATFORM account (pay per token; initially yours)
USE_MOCK_AI=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# --- CLIENT-OWNED credentials (hotel connects their accounts) ---

# Priority 1 — Cloudbeds (Client PMS)
CLOUDBEDS_CLIENT_ID=
CLOUDBEDS_CLIENT_SECRET=
CLOUDBEDS_API_KEY=
CLOUDBEDS_PROPERTY_ID=
CLOUDBEDS_REDIRECT_URI=http://127.0.0.1:8000/api/webhooks/cloudbeds/oauth/callback

# Priority 2 — WhatsApp Business (Client Meta WABA)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=revisit-whatsapp-verify
WHATSAPP_APP_SECRET=

# Priority 3 — Email (Client; Resend preferred, Postmark alternative)
EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=

# Priority 5 — Google Business Profile (Client; official API only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_ACCOUNT_ID=
GOOGLE_LOCATION_ID=

# Priority 6 — Stripe upsells (Client Stripe account)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=eur

# Frontend
INTERNAL_API_URL=http://127.0.0.1:8000
# Do not set NEXT_PUBLIC_API_URL for browser absolute calls in Docker;
# the app uses same-origin /api rewrites instead.
